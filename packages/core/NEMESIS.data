[nemesis]
version=1.0
id=gen5w.kr.core
name=Gen5W KR - CarPlay HUD
package-version=0.3.34
short-desc=CarPlay 길안내를 계기판·HUD에 표시
depends=!projection.tbt,!enhanced.projection
types=application,service
preinstall=scripts/pre.sh

[app.0]
kind=apk
path=app/gen5w-core.apk
package=kr.gen5w.core

[service.0]
name=core
kind=instance
path=kr.gen5w.core/.CoreService
mode=background

[service.1]
name=owner
kind=sh
path=scripts/owner.sh
uid=system
mode=restart
