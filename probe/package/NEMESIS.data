[nemesis]
version=1.0
id=gen5w.kr.probe
name=Gen5W KR diagnostic log collector (read-only)
package-version=0.3.34
short-desc=시동 안내·CarPlay 진단 로그를 USB에 저장
types=application,service

[app.0]
kind=apk
path=app/gen5w-probe.apk
package=kr.gen5w.probe

[app.1]
kind=sh
path=bin/collect.sh
uid=root

[service.0]
name=probe
kind=instance
path=kr.gen5w.probe/.ProbeService
mode=background
